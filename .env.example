# ============================================================
# ADAM-Enhanced Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ----- Application -----
APP_NAME="ADAM-1 Enhanced"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# ----- Backend API -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:3000

# ----- PostgreSQL Database -----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=adam_enhanced
POSTGRES_USER=adam_user
POSTGRES_PASSWORD=change_me_in_production

# Full async DSN (constructed from above in production)
DATABASE_URL=postgresql+asyncpg://adam_user:change_me_in_production@db:5432/adam_enhanced

# ----- pgvector -----
PGVECTOR_ENABLED=true

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="ADAM-1 Enhanced"

# ----- Security -----
SECRET_KEY=change_this_to_a_long_random_string_in_production

# ----- Future Phase: OpenAI (DO NOT fill in until Phase 4) -----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ----- Future Phase: LangChain (DO NOT fill in until Phase 4) -----
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false

# ----- Logging -----
LOG_LEVEL=INFO
