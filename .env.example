# ============================================================
# ADAM-1 Enhanced Environment Variables (.env.example)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Application -----
APP_NAME="ADAM-1 Enhanced"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# ----- Backend Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
API_PREFIX=/api

# ----- CORS -----
# Comma-separated list of allowed origins or "*"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://adam-enhanced-frontend.onrender.com

# ----- PostgreSQL Database -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adam_enhanced
POSTGRES_USER=adam_user
POSTGRES_PASSWORD=change_me_in_production

# Full async DSN (Render PostgreSQL URL automatically normalized)
DATABASE_URL=postgresql+asyncpg://adam_user:change_me_in_production@localhost:5432/adam_enhanced

# ----- pgvector -----
PGVECTOR_ENABLED=true

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="ADAM-1 Enhanced"

# ----- Security -----
SECRET_KEY=generate_a_secure_random_string_in_production

# ----- AI / LLM Provider (Groq Free Tier) -----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# ----- Logging -----
LOG_LEVEL=INFO
